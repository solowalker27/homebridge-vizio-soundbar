{
  "name": "@solowalker27/homebridge-vizio-soundbar",
  "version": "0.1.1",
  "displayName": "Homebridge Vizio Soundbar",
  "description": "Local HomeKit control for Vizio SmartCast soundbars",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": "./dist/index.js",
  "files": [
    "dist",
    "config.schema.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/solowalker27/homebridge-vizio-soundbar.git"
  },
  "bugs": {
    "url": "https://github.com/solowalker27/homebridge-vizio-soundbar/issues"
  },
  "homepage": "https://github.com/solowalker27/homebridge-vizio-soundbar#readme",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || ^26.0.0",
    "homebridge": "^2.4.0"
  },
  "keywords": [
    "homebridge-plugin",
    "vizio",
    "soundbar",
    "homekit"
  ],
  "scripts": {
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\"",
    "build": "npm run clean && tsc",
    "lint": "eslint . --max-warnings=0",
    "test": "npm run build && node --test test/*.test.js",
    "check": "npm run lint && npm test",
    "watch": "tsc --watch",
    "prepublishOnly": "npm run check",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.13.0",
    "homebridge": "^2.4.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
